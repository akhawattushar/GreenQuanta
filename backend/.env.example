# ---------------------------------------------------------------------------
# GreenQuanta / QuantaFleet backend — copy to .env and edit.
# ---------------------------------------------------------------------------

APP_ENV=development

# CHANGE THIS. Any random 32+ character string. Tokens signed with the default
# value are not secure and the service logs an error outside development.
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated addresses allowed to self-register as admin. The very first
# account created on an empty database always becomes admin regardless.
ADMIN_EMAILS=

# MongoDB Atlas connection string (or a local mongod URI for development).
# The repository layer in app/db/database.py is the only place that touches the driver.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=quantafleet

# ---- ML artifacts ---------------------------------------------------------
ARTIFACTS_DIR=./artifacts
MODEL_PATH=model_trainer/best_model.pkl
PREPROCESSOR_PATH=data_transformation/preprocessor.pkl
FEATURE_NAMES_PATH=data_transformation/feature_names.json
TRANSFORMATION_REPORT_PATH=data_transformation/transformation_report.json
TEST_SET_PATH=data_transformation/transformed_data/transformed_test.npz

# The training artifacts never record the unit of `fuel_consumption_rate`.
# Set the unit here and flip the flag once you have confirmed it against the
# source dataset. Until then the API reports unit_verified=false.
MODEL_TARGET_UNIT=kg/h
MODEL_TARGET_UNIT_VERIFIED=false

# ---- cost / emission assumptions (NOT learned by the model) ---------------
FUEL_PRICE_USD_PER_TONNE=650
USD_TO_INR=88

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
